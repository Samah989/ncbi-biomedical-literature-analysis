# ---------------------------------------------------------------------------
# HTCondor submit file: NCBI PubMed data pull
# Target: ap40.uw.osg-htc.org (OSPool)
# Usage:  condor_submit pull_data.submit
#
# IMPORTANT: put your NCBI API key in ~/.ncbi_env on the access point:
#     echo 'export NCBI_API_KEY=YOUR_KEY'   >  ~/.ncbi_env
#     echo 'export NCBI_EMAIL=you@x.com'    >> ~/.ncbi_env
#     chmod 600 ~/.ncbi_env
# and source it before condor_submit.
# ---------------------------------------------------------------------------

container_image = /cvmfs/singularity.opensciencegrid.org/opensciencegrid/osgvo-ubuntu-20.04:latest

executable = pull_data.sh

# Pass env into the job. `getenv` limits to the two we care about.
environment = "NCBI_API_KEY=$ENV(NCBI_API_KEY) NCBI_EMAIL=$ENV(NCBI_EMAIL) FIELD_QUERY=$ENV(FIELD_QUERY)"

transfer_input_files = pull_all_pubmed.py, requirements-osg.txt, ../src

transfer_output_files = data
should_transfer_files = YES
when_to_transfer_output = ON_EXIT

request_cpus   = 1
request_memory = 4 GB
request_disk   = 8 GB

+JobDurationCategory = "Medium"      # NCBI throttles; 100K records ~30 min with a key

max_retries = 3
# OS is provided by container_image above; no additional host-OS requirement needed.

log             = logs/pull.$(Cluster).log
output          = logs/pull.$(Cluster).out
error           = logs/pull.$(Cluster).err
stream_output   = True
stream_error    = True

queue 1
